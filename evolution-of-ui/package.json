{
  "name": "evolution-of-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Evolution of UI — scroll through sixty years of interfaces. One little computer (a note, a photo, three messages) redrawn by every decade: DOS, Windows 95, Web 2.0, Material Design, Glassmorphism and a 2040 hologram. Qwik 1 (static) + native CSS scroll-driven animations + WebGPU.",
  "scripts": {
    "dev": "vite --mode ssr --port 5187",
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "lint": "eslint \"src/**/*.ts*\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check:wgsl": "node scripts/check-wgsl.mjs",
    "preview": "qwik build preview && vite preview --port 5187",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist/three-js-and-animations/evolution-of-ui -e evolution-of-ui",
    "qwik": "qwik"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.1",
    "@builder.io/qwik-city": "^1.20.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@webgpu/types": "^0.1.74",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-qwik": "^1.20.1",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "undici": "^7.30.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^4.3.2"
  }
}
