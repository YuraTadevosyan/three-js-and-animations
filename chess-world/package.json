{
  "name": "chess-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive Chess World \u2014 a chess game where every move is choreographed. Knights leap in a real arc, rooks charge behind a shockwave, bishops streak down the diagonal, queens dissolve into particles and rematerialise, captured pieces burst apart, and the camera covers all of it. Hand-written chess engine (legal move generation, SAN, alpha-beta search in a worker) with no chess library, rendered with the PlayCanvas engine under a Nuxt 4 UI.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "check:perft": "esbuild tools/perft.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/perft.mjs --log-level=error && node node_modules/.cache/perft.mjs",
    "check:geometry": "esbuild tools/geometry.ts --bundle --platform=node --format=esm --external:playcanvas --outfile=node_modules/.cache/geometry.mjs --log-level=error && node node_modules/.cache/geometry.mjs",
    "check:audio": "esbuild tools/audio.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/audio.mjs --log-level=error && node node_modules/.cache/audio.mjs",
    "check:games": "esbuild tools/games.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/games.mjs --log-level=error && node node_modules/.cache/games.mjs",
    "check:ui": "esbuild tools/interaction.ts --bundle --platform=node --format=esm --tsconfig=tools/tsconfig.probe.json --outfile=node_modules/.cache/interaction.mjs --log-level=error && node node_modules/.cache/interaction.mjs",
    "check:world": "esbuild tools/headless.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/headless.mjs --log-level=error && node node_modules/.cache/headless.mjs",
    "check:cinema": "esbuild tools/cinema.ts --bundle --platform=node --format=esm --tsconfig=tools/tsconfig.probe.json --alias:~/world/world=./app/world/world --outfile=node_modules/.cache/cinema.mjs --log-level=error && node node_modules/.cache/cinema.mjs",
    "check": "npm run typecheck && npm run check:perft && npm run check:geometry && npm run check:audio && npm run check:games && npm run check:ui && npm run check:world && npm run check:cinema",
    "predeploy": "npm run generate",
    "deploy": "gh-pages -d .output/public -e chess-world"
  },
  "dependencies": {
    "playcanvas": "^2.21.4",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0",
    "nuxt": "^4.5.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11"
  }
}
